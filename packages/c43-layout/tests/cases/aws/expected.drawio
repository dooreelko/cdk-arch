<mxCell id="title" value="Event-driven order processing on AWS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="12" y="-228" width="1076" height="30" as="geometry" /></mxCell>
<mxCell id="description" value="Customers reach the storefront through CloudFront, which serves static assets and forwards API calls to API Gateway. Three Lambda functions handle orders, payments and reporting; order and payment data land in S3, while reporting queries run through Athena over the same bucket. Route53 provides DNS and the TLS certificate for the distribution. A CloudWatch alarm watches the Lambdas and, together with the order Lambda, sends notification emails through SES." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;fontSize=24;" vertex="1" parent="1"><mxGeometry x="12" y="-198" width="1076" height="180" as="geometry" /></mxCell>
