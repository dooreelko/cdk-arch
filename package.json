{
  "name": "cdk-arch-workspace",
  "private": true,
  "workspaces": [
    "packages/cdk-arch",
    "packages/example/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces && cargo build --release",
    "clean": "npm run clean --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present",
    "test": "cd packages/cdk-arch && npm run test && cd ../.. && cargo test --workspace"
  },
  "version": "0.1.0"
}
